   "layoutVersion": "GRID_V1",
   "layout": [
    {
     "widget": {
      "name": "ml_ra_hdr",
      "multilineTextboxSpec": {
       "lines": [
        "# Risk Analytics \u2014 model-driven\nRenewal-risk composite from two trained models (delivery-shortfall + renewal-risk). Quadrant prioritises high churn-probability \u00d7 high revenue; the bar decomposes each score into its drivers."
       ]
      }
     },
     "position": {
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 1
     }
    },
    {
     "widget": {
      "name": "ml_quadrant",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "ds_ml_risk",
         "fields": [
          {
           "name": "advertiser_name",
           "expression": "`advertiser_name`"
          },
          {
           "name": "p_churn",
           "expression": "`p_churn`"
          },
          {
           "name": "revenue_at_risk",
           "expression": "`revenue_at_risk`"
          },
          {
           "name": "risk_tier",
           "expression": "`risk_tier`"
