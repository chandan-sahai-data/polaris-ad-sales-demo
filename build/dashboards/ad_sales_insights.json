{
 "datasets": [
  {
   "name": "ds_camp",
   "displayName": "Campaign delivery (drill-through + freshness)",
   "queryLines": [
    "SELECT account_owner, advertiser_name AS advertiser, campaign_id, category, campaign_pacing_ratio, delivery_status,        booked_spend, reach_delivery_ratio, in_target_pct, audience_quality_score,        nielsen_is_stale, nielsen_lag_hours, adserver_lag_hours FROM gold_campaign_delivery"
   ],
   "catalog": "cs_genie_research_catalog",
   "schema": "ad_sales"
  },
  {
   "name": "ds_silver_accounts",
   "displayName": "Silver Accounts",
   "queryLines": [
    "SELECT\n",
    "  advertiser_id,\n",
    "  advertiser_name,\n",
    "  category,\n",
    "  region,\n",
    "  account_owner,\n",
    "  source_system,\n",
    "  last_refresh,\n",
    "  _ingested_at\n",
    "FROM\n",
    "  silver_accounts"
   ],
   "catalog": "cs_genie_research_catalog",
   "schema": "ad_sales"
  },
  {
   "name": "ds_silver_deals",
   "displayName": "Silver Deals",
   "queryLines": [
    "SELECT\n",
    "  deal_id,\n",
    "  advertiser_id,\n",
    "  stage,\n",
    "  contract_value,\n",
    "  deal_start,\n",
    "  deal_end,\n",
    "  renewal_date,\n",
    "  upfront_commit_flag,\n",
    "  renewal_window,\n",
    "  source_system,\n",
    "  last_refresh,\n",
    "  _ingested_at,\n",
    "  days_to_renewal\n",
    "FROM\n",
    "  silver_deals"
   ],
   "catalog": "cs_genie_research_catalog",
   "schema": "ad_sales"
  },
  {
   "name": "ds_silver_nielsen",
   "displayName": "Silver Nielsen",
   "queryLines": [
    "SELECT\n",
    "  campaign_id,\n",
    "  advertiser_id,\n",
    "  target_demo,\n",
    "  planned_reach,\n",
    "  delivered_reach,\n",
    "  reach_delivery_ratio,\n",
    "  gross_rating_points,\n",
    "  target_audience_impressions,\n",
    "  in_target_pct,\n",
    "  avg_frequency,\n",
    "  audience_quality_score,\n",
    "  source_system,\n",
    "  last_refresh,\n",
    "  _ingested_at,\n",
    "  _source_file\n",
    "FROM\n",
    "  dash_silver_nielsen"
   ],
   "catalog": "cs_genie_research_catalog",
   "schema": "ad_sales"
  }
